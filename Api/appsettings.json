{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "listings-route": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/listings/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/listings/{**catch-all}" } ]
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/users/{**catch-all}" } ]
      },
      "media-route": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/media/{**catch-all}" }
      }
    },
    "Clusters": {
      "listings-cluster": {
        "Destinations": {
          "d1": { "Address": "http://127.0.0.1:5101/" }
        }
      },
      "users-cluster": {
        "Destinations": {
          "d1": { "Address": "http://127.0.0.1:5102/" }
        }
      }
    }
  }
}
